# NagarMitra Backend Environment Variables Configuration
# Copy this file to .env and configure with your credentials

# Port for the Node.js Express server
PORT=5000

# MongoDB Connection String:
# Remote MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Local MongoDB: mongodb://localhost:27017/nagarmitra
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nagarmitra?retryWrites=true&w=majority

# JSON Web Token Secret Key (use a secure random string)
JWT_SECRET=replace_with_a_long_random_secret_string

# Designated Administrator Account Credentials (used by npm run seed-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Environment
NODE_ENV=production

# Production CORS Allowed Origins (Comma-separated, or leave empty for wildcard)
# Example: https://nagarmitra.pages.dev,http://localhost:5000
ALLOWED_ORIGINS=https://nagarmitra.pages.dev,http://localhost:5000

